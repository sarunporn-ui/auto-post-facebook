# ---------------------------------------------------------------------------
# Automated Content OS — environment configuration
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- LLM Provider selection --------------------------------------------------
# One of: openai | anthropic | gemini
LLM_PROVIDER=openai
# Model name must match the chosen provider, e.g.:
#   openai:    gpt-5.5, gpt-5.5-pro
#   anthropic: claude-sonnet-5, claude-opus-5
#   gemini:    gemini-1.5-pro
LLM_MODEL=gpt-5.5

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Note: OPENAI_API_KEY is also used to generate real images for Format 2
# (via DALL-E), even if LLM_PROVIDER above is set to anthropic or gemini.

# Used by the YouTube ingestor's Whisper fallback (videos with no captions)
WHISPER_MODEL=whisper-1

# --- Telegram Bot (Module 3: Approval Interface) -----------------------------
TELEGRAM_BOT_TOKEN=
# Chat ID that receives topic/format approval prompts (user, group, or channel)
TELEGRAM_CHAT_ID=

# --- Approval Webhook (alternative to Telegram, e.g. dashboard/Airtable) -----
APPROVAL_WEBHOOK_SECRET=change-me

# --- Meta Graph API (Facebook Page publishing) -------------------------------
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v19.0

# --- WordPress REST API (long-form article publishing) -----------------------
WORDPRESS_URL=https://your-site.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- App server ---------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
