# ---------------------------------------------------------------------------
# Automated Content OS — environment configuration
#   cp .env.example .env   and fill in what you need.
# Locally you can leave the Supabase/Facebook blocks empty: the app runs in
# single-user "dev mode" against a local SQLite file with no login.
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
LLM_PROVIDER=openai            # openai | anthropic | gemini
LLM_MODEL=gpt-5.5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
WHISPER_MODEL=whisper-1        # fallback for YouTube videos with no captions

# --- Webshare proxy (free tier: 10 proxies / 250GB monthly, no card) -------
# Only needed in production — cloud hosts (Railway, AWS...) get IP-blocked by
# YouTube directly; a home IP doesn't, so leave blank in local dev.
# Get credentials at webshare.io → Dashboard → Proxy (not your login password).
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# --- Database ------------------------------------------------------------
# Local default (unset) = sqlite file under ./data/.
# Production (Supabase): use the connection pooler URL, with the +psycopg driver:
#   postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# --- Supabase (Auth + Storage) ----------------------------------------
# Leave blank locally to skip login. Set all four to turn on real auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=generated

# --- Facebook Login / Page publishing --------------------------------
# From your Meta app (developers.facebook.com). Redirect URI must match exactly.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v21.0
FACEBOOK_REDIRECT_URI=http://localhost:8000/connect/facebook/callback
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts

# --- Secrets ----------------------------------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
INTERNAL_CRON_SECRET=change-me
APPROVAL_WEBHOOK_SECRET=change-me

# --- App ------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Supadata (hosted YouTube transcript API — sidesteps the IP block) -----
# Only needed in production. supadata.ai → sign up → Dashboard → API Key.
# Free tier: 100 credits/month, no card.
SUPADATA_API_KEY=
